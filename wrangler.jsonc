{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tell-me-everything-about",
	"main": "src/index.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	// The page itself is static and served from the edge cache; only the
	// account and sync routes reach the Worker.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page",
		"run_worker_first": [
			"/api/*",
			"/auth/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "tmea",
			"database_id": "9027c8cc-8bd6-4dd8-9577-aded15ae1224",
			"migrations_dir": "./migrations"
		}
	],
	// The page answers on tmea.space; Cloudflare owns the DNS record and the
	// certificate for it. workers.dev stays on as a fallback address.
	"triggers": {
		// Explore: the day's list is written at 05:10 UTC (src/explore.js).
		"crons": ["10 5 * * *"]
	},
	"workers_dev": true,
	"routes": [
		{ "pattern": "tmea.space", "custom_domain": true }
	],
	// Magic-link mail through Cloudflare Email Service, sending from
	// tmea.space (onboarded with `wrangler email sending enable tmea.space`).
	// RESEND_API_KEY is the alternative; DEV_LINKS=1 prints the link instead.
	// "send_email": [{ "name": "EMAIL" }],
	"vars": {
		"APP_NAME": "Tell me everything about",
		"MAIL_FROM": "hello@tmea.space",
		"DEV_LINKS": "0",
		"CF_ZONE_TAG": "3992b9a02e8da1c5402f57d9e8f98600",
		// The Claude model that writes the daily Explore list. Change and redeploy.
		"EXPLORE_MODEL": "claude-sonnet-5-5"
	}
}
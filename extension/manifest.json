{
  "manifest_version": 3,
  "name": "Tell me everything about — new tab",
  "short_name": "tmea.space",
  "version": "0.1.0",
  "description": "Opens tmea.space in every new tab: a home page that finishes your prompt for you.",
  "homepage_url": "https://tmea.space/",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "newtab@tmea.space",
      "strict_min_version": "109.0"
    }
  }
}

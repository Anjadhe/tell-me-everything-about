# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
# With DEV_LINKS=1 the magic link is returned to the page and logged
# instead of being emailed, so sign-in works with no mail provider.
DEV_LINKS=1
# RESEND_API_KEY=re_...
# Dashboard at /admin. Set with `npx wrangler secret put ADMIN_KEY` in production.
ADMIN_KEY=dev-admin-key
# Edge traffic on the dashboard: an API token with Analytics:Read on the zone.
# CF_ANALYTICS_TOKEN=...
# Explore: without a key the page shows the evergreen list. With one,
# "Write today's list now" on /admin (or the cron) writes today's list.
# ANTHROPIC_API_KEY=sk-ant-...
# EXPLORE_MODEL=claude-haiku-5-5      # optional; wrangler.jsonc sets the default
# NASA_API_KEY=...                   # optional; DEMO_KEY otherwise
